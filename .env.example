# Keep the CopperOS token only on your computer. Do not put it in browser JS.
COPPEROS_TASK_API_TOKEN=replace-with-the-same-token-you-set-in-CopperOS-broker
COPPEROS_API_BASE=http://127.0.0.1:7332

# Optional Vercel server-side bridge to a separately deployed scientific service.
# Leave empty for an explicitly bounded bundled-real-data frontend deployment.
# Never prefix these values with VITE_: backend tokens must not reach the browser.
SCIENCE_API_URL=
SCIENCE_API_TOKEN=
