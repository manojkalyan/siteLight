{
  "name": "sitelight-navigator",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/run-vite.mjs --host 127.0.0.1",
    "build": "node scripts/run-vite.mjs build",
    "build:cinematic": "node scripts/build-cinematic-prototype.mjs",
    "build:workspace": "node scripts/build-workspace.mjs",
    "data:workspace": "node scripts/collect-workspace-data.mjs",
    "science:bootstrap": "node scripts/bootstrap-science.mjs",
    "science:acquire": "node scripts/acquire-science-inputs.mjs && node scripts/acquire-geometry-reference.mjs && node scripts/acquire-orientation-reference.mjs",
    "science:thermal": "node scripts/acquire-thermal.mjs",
    "science:custom-index": "node scripts/index-custom-thermal.mjs",
    "science:prepare": ".tools\\python\\python.exe scripts\\validate-orientation.py && .tools\\python\\python.exe scripts\\science_pipeline.py",
    "science:test": ".tools\\python\\python.exe -m unittest discover -s tests-science -v",
    "engineering:acquire": "node scripts/acquire-engineering.mjs",
    "engineering:verify": ".tools\\python\\python.exe scripts/verify-engineering-references.py",
    "dust:acquire": "node scripts/acquire-dust.mjs",
    "dust:verify": ".tools\\python\\python.exe scripts/verify-dust-references.py",
    "plume:acquire": "node scripts/acquire-plume.mjs",
    "plume:verify": ".tools\\python\\python.exe scripts/verify-plume-references.py",
    "radiation:acquire": "node scripts/acquire-radiation.mjs",
    "radiation:prepare": ".tools\\python\\python.exe scripts/prepare-radiation.py",
    "benchmark": "node scripts/benchmark-workspace.mjs",
    "preview": "node scripts/run-vite.mjs preview --host 127.0.0.1",
    "test": "node --test --test-concurrency=2 tests-js/*.test.mjs",
    "start-windows:verify": "node scripts/validate-start-windows.mjs",
    "test:ui": "playwright test --project=ui-chrome",
    "test:ui:debug": "playwright test --project=ui-chrome --debug",
    "test:chrome": "playwright test --project=windows-chrome-review",
    "test:ui:report": "playwright show-report artifacts/playwright-report",
    "pretest:ui": "npm.cmd run build",
    "pretest:chrome": "npm.cmd run build",
    "science:expanded-acquire": "node scripts/acquire-expanded-references.mjs",
    "science:expanded-verify": ".tools\\python\\python.exe scripts/validate-expanded-geometry.py",
    "science:horizon-verify": ".tools\\python\\python.exe scripts/validate-horizon-sampling.py",
    "acceptance:audit": "node scripts/verify-acceptance-sources.mjs",
    "science:expanded-orientation-acquire": "node scripts/acquire-expanded-orientation.mjs",
    "science:expanded-orientation-verify": ".tools\\python\\python.exe scripts/validate-expanded-orientation.py",
    "terrain:acquire-ensembles": ".tools\\python\\python.exe scripts/acquire-terrain-ensembles.py",
    "terrain:compare-stereo": ".tools\\python\\python.exe scripts/compare-stereo-terrain.py",
    "terrain:extend-horizon": ".tools\\python\\python.exe scripts/extend-farfield-audit.py",
    "terrain:prepare-evidence": ".tools\\python\\python.exe scripts/prepare-terrain-acceptance.py",
    "engineering:verify-nasa": ".tools\\python\\python.exe scripts/verify-nasa-reference.py",
    "seismic:acquire": "node scripts/acquire-seismic.mjs",
    "seismic:prepare": ".tools\\python\\python.exe scripts/prepare-seismic.py",
    "test:deployment": "node --test tests-js/deployment.test.mjs tests-js/report-export.test.mjs tests-js/demo-video.test.mjs"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "linkedom": "^0.18.15",
    "three": "^0.187.0",
    "vite": "^8.0.0"
  },
  "engines": {
    "node": "24.x"
  }
}
